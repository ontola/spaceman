<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SpaceMan has to read the whole disk and move files to the Trash,
	     which the App Sandbox does not allow. It is distributed outside the
	     Mac App Store for that reason. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
